---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import DogSide from './DogSide.astro';
import { settings, socialLinks, whatsappLink, whatsappDisplay } from '../lib/site';
const social = socialLinks();
const year = new Date().getFullYear();
const { contact, location } = settings;
const wa = whatsappLink();
---
<footer class="relative mt-0 overflow-hidden bg-bosque-950 text-salvia-100">
  <svg class="block w-full text-blanco" viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0 H1440 V18 C 1200 60, 960 58, 720 34 C 480 10, 240 10, 0 40 Z" fill="currentColor" /></svg>
  <div class="container-alma grid gap-12 pb-12 pt-14 md:grid-cols-12">
    <div class="md:col-span-5">
      <Logo tone="light" />
      <p class="mt-5 max-w-sm text-salvia-200">Club de educación, bienestar, experiencias y cultura animal donde personas y perros aprenden a vivir mejor juntos.</p>
      <p class="mt-4 inline-flex items-center gap-2 text-salvia-300"><Icon name="pin" class="h-5 w-5" /> {location.municipality}, {location.department}</p>
      {(contact.email || contact.phone || wa) && (
        <ul class="mt-4 space-y-2 text-salvia-200">
          {wa && <li><a class="inline-flex items-center gap-2 hover:text-blanco" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" class="h-5 w-5" />WhatsApp {whatsappDisplay()}</a></li>}
          {contact.email && <li><a class="inline-flex items-center gap-2 hover:text-blanco" href={`mailto:${contact.email}`}><Icon name="mail" class="h-5 w-5" />{contact.email}</a></li>}
          {contact.phone && <li><a class="inline-flex items-center gap-2 hover:text-blanco" href={`tel:${contact.phone.replace(/\s/g, '')}`}><Icon name="phone" class="h-5 w-5" />{contact.phone}</a></li>}
        </ul>
      )}
    </div>
    <nav class="md:col-span-3" aria-label="Pie de página">
      <h2 class="font-sans text-sm font-bold uppercase tracking-[0.16em] text-arena-200">Navegación</h2>
      <ul class="mt-4 space-y-2.5">
        <li><a class="hover:text-blanco" href="/alma-canina/">Alma Canina</a></li>
        <li><a class="hover:text-blanco" href="/experiencias/">Experiencias</a></li>
        <li><a class="hover:text-blanco" href="/aprende/">Aprende</a></li>
        <li><a class="hover:text-blanco" href="/legislacion/">Legislación</a></li>
        <li><a class="hover:text-blanco" href="/comunidad/">Comunidad</a></li>
        <li><a class="hover:text-blanco" href="/contacto/">Contacto</a></li>
      </ul>
    </nav>
    <div class="md:col-span-4">
      <h2 class="font-sans text-sm font-bold uppercase tracking-[0.16em] text-arena-200">Síguenos</h2>
      {social.length > 0 ? (
        <ul class="mt-4 flex flex-wrap gap-2">
          {social.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener" class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-blanco/10 transition hover:-translate-y-0.5 hover:bg-blanco/20" aria-label={`${s.label} (se abre en una pestaña nueva)`}><Icon name={s.key} class="h-5 w-5" /></a></li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 text-sm text-salvia-300">Muy pronto en redes sociales.</p>
      )}
      <h2 class="mt-8 font-sans text-sm font-bold uppercase tracking-[0.16em] text-arena-200">Legal</h2>
      <ul class="mt-4 space-y-2.5">
        <li><a class="hover:text-blanco" href="/politica-de-privacidad/">Política de privacidad</a></li>
        <li><a class="hover:text-blanco" href="/tratamiento-de-datos/">Tratamiento de datos</a></li>
        <li><a class="hover:text-blanco" href="/terminos/">Términos</a></li>
      </ul>
    </div>
  </div>
  <div class="relative border-t border-blanco/10">
    <div class="container-alma flex flex-col items-start justify-between gap-4 py-8 md:flex-row md:items-center">
      <p class="font-display text-2xl text-blanco" style="font-variation-settings:'SOFT' 100">{settings.footerFarewell} <span aria-hidden="true">🐾</span></p>
      <p class="text-sm text-salvia-300">Educamos · Conectamos · Transformamos <span aria-hidden="true">🐾</span> · © {year} Alma Canina</p>
    </div>
    <DogSide class="pointer-events-none absolute -top-[46px] right-[8%] h-12 w-auto text-bosque-950" />
  </div>
</footer>
