---
/** Huellas que aparecen al avanzar entre secciones. */
interface Props { count?: number; class?: string }
const { count = 6, class: cls = '' } = Astro.props;
const steps = Array.from({ length: count }, (_, i) => ({ x: i % 2 === 0 ? 0 : 22, r: i % 2 === 0 ? -12 : 12 }));
---
<div class:list={['paw-trail pointer-events-none flex flex-col items-center gap-3', cls]} aria-hidden="true">
  {steps.map((s, i) => (
    <svg class="paw-step h-6 w-6 text-salvia-400" style={`--i:${i};--r:${s.r}deg;margin-left:${s.x}px`} viewBox="0 0 24 24" fill="currentColor">
      <ellipse cx="7" cy="8" rx="2.2" ry="2.8" /><ellipse cx="17" cy="8" rx="2.2" ry="2.8" /><ellipse cx="3.6" cy="13" rx="1.9" ry="2.4" /><ellipse cx="20.4" cy="13" rx="1.9" ry="2.4" />
      <path d="M12 12c-3.2 0-5.4 3.5-5.4 5.6 0 1.7 1.5 2.5 2.9 2.2 1-.2 1.6-.8 2.5-.8s1.5.6 2.5.8c1.4.3 2.9-.5 2.9-2.2 0-2.1-2.2-5.6-5.4-5.6z" />
    </svg>
  ))}
</div>
