---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import LawCard from '../../components/LawCard.astro';
import { render } from 'astro:content';
import { LAW_TAGS, LEGAL_DISCLAIMER, formatDate } from '../../lib/site';
import { getLaws } from '../../lib/content';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const laws = await getLaws();
  return laws.map((law) => ({ params: { slug: law.id }, props: { law } }));
}
const { law } = Astro.props;
const d = law.data;
const { Content } = await render(law);
const hasBody = (law.body ?? '').trim().length > 0;
const others = (await getLaws()).filter((l) => l.id !== law.id && l.data.tags.some((t) => d.tags.includes(t))).slice(0, 3);
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Legislación', path: '/legislacion/' },
  { name: d.popularName, path: `/legislacion/${law.id}/` },
];
const toc = [
  { id: 'de-que-trata', label: '¿De qué trata?' },
  { id: 'problema', label: '¿Qué problema busca solucionar?' },
  d.keyChanges.length && { id: 'que-cambia', label: '¿Qué cambia?' },
  d.beneficiaries.length && { id: 'beneficia', label: '¿A quién protege?' },
  d.obligations.length && { id: 'obligaciones', label: '¿Qué obligaciones crea?' },
  (d.citizenMeaning || d.citizenTools.length) && { id: 'ciudadanos', label: '¿Qué significa para mí?' },
  d.routes.length && { id: 'ruta', label: 'Ruta práctica' },
  hasBody && { id: 'mas', label: 'Profundiza' },
  d.authorities.length && { id: 'autoridades', label: 'Autoridades' },
  d.faq.length && { id: 'faq', label: 'Preguntas frecuentes' },
  { id: 'fuentes', label: 'Documentos y fuentes' },
].filter(Boolean) as { id: string; label: string }[];
---
<BaseLayout
  overlayHeader
  title={`${d.popularName} — Ley ${d.lawNumber} de ${d.year} explicada`}
  description={`${d.popularName} (Ley ${d.lawNumber} de ${d.year}): ${d.topic} Explicación ciudadana, qué cambia, rutas prácticas y fuentes oficiales.`}
  type="article"
  schema={[
    breadcrumbSchema(Astro.site!, crumbs),
    {
      '@context': 'https://schema.org',
      '@type': 'Legislation',
      name: d.title,
      alternateName: d.popularName,
      legislationIdentifier: `Ley ${d.lawNumber} de ${d.year}`,
      legislationJurisdiction: 'CO',
      legislationType: 'Ley',
      inLanguage: 'es',
      abstract: d.summary,
      ...(d.officialDocument ? { url: d.officialDocument.url } : {}),
    },
    ...(d.faq.length ? [faqSchema(d.faq)] : []),
  ]}
>
  <header class="relative overflow-hidden bg-bosque-900 pb-16 pt-32 text-blanco md:pt-40">
    <div aria-hidden="true" class="blob-1 absolute -right-32 -top-32 h-[28rem] w-[28rem] bg-bosque-800"></div>
    <div class="container-alma relative">
      <Breadcrumbs items={crumbs} dark />
      <div class="mt-8 flex flex-wrap gap-2">
        <span class="chip bg-salvia-200 font-bold uppercase tracking-wide text-bosque-900"><Icon name="scale" class="h-4 w-4" />Ley {d.lawNumber} de {d.year}</span>
        <span class="chip bg-blanco/10 text-blanco"><Icon name="check" class="h-4 w-4" />{d.status}</span>
      </div>
      <h1 class="display-lg mt-5 max-w-4xl text-blanco">{d.popularName}</h1>
      <p class="mt-3 max-w-3xl text-lg text-salvia-200">{d.title}</p>
      <dl class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div class="rounded-2xl bg-blanco/5 p-4"><dt class="text-sm text-salvia-300">Número oficial</dt><dd class="mt-1 font-semibold">Ley {d.lawNumber}</dd></div>
        <div class="rounded-2xl bg-blanco/5 p-4"><dt class="text-sm text-salvia-300">Año</dt><dd class="mt-1 font-semibold">{d.year}</dd></div>
        <div class="rounded-2xl bg-blanco/5 p-4"><dt class="text-sm text-salvia-300">Fecha de expedición</dt><dd class="mt-1 font-semibold">{d.sanctionDate}</dd></div>
        <div class="rounded-2xl bg-blanco/5 p-4"><dt class="text-sm text-salvia-300">Publicación</dt><dd class="mt-1 font-semibold">{d.publication || 'Pendiente de verificación'}</dd></div>
      </dl>
      <p class="mt-6 max-w-3xl"><span class="font-semibold text-arena-200">Tema:</span> {d.topic}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        {d.officialDocument && <a href={d.officialDocument.url} target="_blank" rel="noopener" class="btn btn-light">Consultar ley <Icon name="external" class="h-5 w-5" /></a>}
        {d.pedagogicalSource && <a href={d.pedagogicalSource.url} target="_blank" rel="noopener" class="btn btn-ghost text-blanco">Conocer material pedagógico <Icon name="external" class="h-5 w-5" /></a>}
      </div>
    </div>
  </header>

  <div class="bg-blanco py-14 md:py-20">
    <div class="container-alma grid gap-12 lg:grid-cols-12">
      <nav class="hidden lg:col-span-3 lg:block" aria-label="En esta ficha">
        <div class="sticky top-28 rounded-3xl bg-salvia-50 p-5">
          <p class="text-sm font-bold uppercase tracking-wider text-tinta-suave">En esta ficha</p>
          <ol class="mt-3 space-y-1.5 text-[0.95rem]">
            {toc.map((t) => <li><a href={`#${t.id}`} class="block rounded-lg px-2 py-1 text-bosque-800 no-underline hover:bg-salvia-100">{t.label}</a></li>)}
          </ol>
        </div>
      </nav>

      <div class="space-y-16 lg:col-span-9">
        {d.almaRelevance && (
          <aside class="flex gap-4 rounded-[2rem] bg-arena-100 p-6 md:p-8">
            <Icon name="paw" class="h-7 w-7 shrink-0 text-terracota-700" />
            <div><p class="font-semibold text-bosque-900">¿Por qué nos importa en Alma Canina?</p><p class="mt-1 text-tinta">{d.almaRelevance}</p></div>
          </aside>
        )}

        <section id="de-que-trata" class="reveal">
          <h2 class="display-md text-bosque-900">¿De qué trata?</h2>
          <p class="mt-4 max-w-3xl text-xl leading-relaxed text-tinta">{d.summary}</p>
        </section>

        <section id="problema" class="reveal">
          <h2 class="text-3xl text-bosque-900">¿Qué problema busca solucionar?</h2>
          <p class="mt-4 max-w-3xl text-lg text-tinta-suave">{d.problem}</p>
        </section>

        {d.keyChanges.length > 0 && (
          <section id="que-cambia" class="reveal">
            <h2 class="text-3xl text-bosque-900">¿Qué cambia?</h2>
            <ul class="mt-6 grid gap-3">
              {d.keyChanges.map((c, i) => (
                <li class="flex gap-4 rounded-2xl bg-salvia-50 p-5"><span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-salvia-200 text-sm font-bold text-bosque-900">{i + 1}</span><span class="text-tinta">{c}</span></li>
              ))}
            </ul>
          </section>
        )}

        <div class="grid gap-6 md:grid-cols-2">
          {d.beneficiaries.length > 0 && (
            <section id="beneficia" class="reveal rounded-[2rem] bg-crema p-7">
              <h2 class="text-2xl text-bosque-900">¿A quién protege o beneficia?</h2>
              <ul class="mt-4 space-y-2">{d.beneficiaries.map((b) => <li class="flex gap-2"><Icon name="heart" class="mt-1 h-5 w-5 shrink-0 text-terracota-700" />{b}</li>)}</ul>
            </section>
          )}
          {d.obligations.length > 0 && (
            <section id="obligaciones" class="reveal rounded-[2rem] bg-cielo-200/40 p-7">
              <h2 class="text-2xl text-bosque-900">¿Qué obligaciones crea?</h2>
              <ul class="mt-4 space-y-3">{d.obligations.map((o) => <li class="flex gap-2"><Icon name="doc" class="mt-1 h-5 w-5 shrink-0 text-cielo-700" />{o}</li>)}</ul>
            </section>
          )}
        </div>

        {(d.citizenMeaning || d.citizenTools.length > 0) && (
          <section id="ciudadanos" class="reveal">
            <h2 class="text-3xl text-bosque-900">¿Qué significa para los ciudadanos?</h2>
            {d.citizenMeaning && <p class="mt-4 max-w-3xl text-lg text-tinta">{d.citizenMeaning}</p>}
            {d.citizenTools.length > 0 && (
              <>
                <h3 class="mt-8 text-2xl text-bosque-900">¿Qué puedo hacer gracias a esta ley?</h3>
                <ul class="mt-4 grid gap-3 sm:grid-cols-2">{d.citizenTools.map((t) => <li class="flex gap-3 rounded-2xl border-2 border-salvia-200 p-4"><Icon name="check" class="h-5 w-5 shrink-0 text-bosque-700" />{t}</li>)}</ul>
              </>
            )}
          </section>
        )}

        {d.routes.length > 0 && (
          <section id="ruta" class="reveal">
            <h2 class="text-3xl text-bosque-900">Ruta práctica</h2>
            <div class="mt-6 space-y-6">
              {d.routes.map((r) => (
                <div class="rounded-[2rem] bg-bosque-900 p-6 text-blanco md:p-8">
                  <p class="font-display text-2xl">Si estás frente a esta situación: <span class="text-terracota-300">{r.situation}</span></p>
                  <p class="mt-1 text-salvia-200">→ Estos son los pasos:</p>
                  <ol class="mt-5 grid gap-3">
                    {r.steps.map((s, i) => <li class="flex gap-4 rounded-2xl bg-blanco/5 p-4"><span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-terracota-500 text-sm font-bold">{i + 1}</span><span>{s}</span></li>)}
                  </ol>
                </div>
              ))}
            </div>
          </section>
        )}

        {hasBody && (
          <section id="mas" class="prose-alma reveal max-w-none text-lg"><Content /></section>
        )}

        {d.authorities.length > 0 && (
          <section id="autoridades" class="reveal">
            <h2 class="text-3xl text-bosque-900">Autoridades relacionadas</h2>
            <ul class="mt-6 grid gap-3 md:grid-cols-2">
              {d.authorities.map((a) => <li class="rounded-2xl bg-salvia-50 p-5"><p class="font-semibold text-bosque-900">{a.name}</p><p class="mt-1 text-tinta-suave">{a.role}</p></li>)}
            </ul>
          </section>
        )}

        {d.faq.length > 0 && (
          <section id="faq" class="reveal">
            <h2 class="text-3xl text-bosque-900">Preguntas frecuentes</h2>
            <div class="accordion mt-6 space-y-3">
              {d.faq.map((f) => (
                <details class="border border-salvia-200"><summary>{f.q}<Icon name="plus" class="acc-icon h-6 w-6 text-terracota-700" /></summary><div class="acc-body"><p>{f.a}</p></div></details>
              ))}
            </div>
          </section>
        )}

        <section id="fuentes" class="reveal rounded-[2rem] border-2 border-salvia-200 p-6 md:p-8">
          <h2 class="text-3xl text-bosque-900">Documentos y fuentes</h2>
          <div class="mt-6 grid gap-4 md:grid-cols-2">
            {d.officialDocument && (
              <div class="rounded-2xl bg-salvia-50 p-5">
                <p class="text-sm font-bold uppercase tracking-wider text-tinta-suave">Documento oficial</p>
                <p class="mt-1 text-bosque-900">{d.officialDocument.label}</p>
                <a href={d.officialDocument.url} target="_blank" rel="noopener" class="btn btn-primary mt-4 !min-h-11">Consultar ley <Icon name="external" class="h-5 w-5" /></a>
              </div>
            )}
            {d.pedagogicalSource && (
              <div class="rounded-2xl bg-arena-100 p-5">
                <p class="text-sm font-bold uppercase tracking-wider text-tinta-suave">Fuente pedagógica</p>
                <p class="mt-1 text-bosque-900">{d.pedagogicalSource.label}</p>
                <a href={d.pedagogicalSource.url} target="_blank" rel="noopener" class="btn btn-terracota mt-4 !min-h-11">Conocer material pedagógico <Icon name="external" class="h-5 w-5" /></a>
              </div>
            )}
          </div>
          {d.sources.length > 0 && (
            <>
              <h3 class="mt-8 text-xl text-bosque-900">Fuentes consultadas</h3>
              <ul class="mt-3 space-y-2">{d.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener" class="inline-flex items-start gap-2 text-bosque-700 underline decoration-salvia-400 decoration-2 underline-offset-4 hover:decoration-terracota-500"><Icon name="link" class="mt-1 h-4 w-4 shrink-0" />{s.label}</a></li>)}</ul>
              <p class="mt-3 text-sm text-tinta-suave">Contenido pedagógico elaborado por Alma Canina a partir de las fuentes citadas. El material pedagógico externo pertenece a sus autores.</p>
            </>
          )}
          <div class="mt-6 flex flex-wrap gap-2">{d.tags.map((t) => <span class="chip bg-crema text-sm text-tinta-suave">{LAW_TAGS[t] || t}</span>)}</div>
          <p class="mt-6 text-sm font-semibold text-bosque-900">Última actualización: <time datetime={d.lastUpdated.toISOString()}>{formatDate(d.lastUpdated)}</time></p>
        </section>

        <p class="rounded-2xl bg-crema p-5 text-tinta"><Icon name="info" class="mr-2 inline h-5 w-5 text-terracota-700" />{LEGAL_DISCLAIMER}</p>
      </div>
    </div>
  </div>

  {others.length > 0 && (
    <section class="bg-salvia-100 py-16" aria-labelledby="otras">
      <div class="container-alma">
        <h2 id="otras" class="display-md text-bosque-900">Otras normas relacionadas</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{others.map((o, i) => <LawCard item={o} index={i} />)}</div>
        <a href="/legislacion/" class="btn btn-primary mt-10"><Icon name="arrow-left" class="h-5 w-5" />Volver al centro de legislación</a>
      </div>
    </section>
  )}
</BaseLayout>
